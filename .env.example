# Configuración de Base de Datos
# Por defecto PostgreSQL (docker compose up db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alliot_db

# Alternativa rápida SQLite (descomentar para usar sin Docker):
# DATABASE_URL=sqlite:///./alliot.db

# Configuración de Servidor Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Configuración de Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
